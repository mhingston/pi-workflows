{
  "name": "pi-workflows-feasibility",
  "private": true,
  "type": "module",
  "description": "Dependency-pinned, non-production API probes for issue #1",
  "engines": {
    "node": ">=22.16.0"
  },
  "scripts": {
    "probe:durable": "node --experimental-strip-types examples/feasibility/durable-child-tasks.ts",
